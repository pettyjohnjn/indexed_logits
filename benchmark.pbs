#!/bin/bash
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -q debug
#PBS -l filesystems=home:grand:eagle
#PBS -A ModCon
#PBS -N indexed_logits_bench

set -euo pipefail

REPO_DIR="/lus/eagle/projects/ModCon/jpettyjohn/indexed_logits"
RESULTS_DIR="${REPO_DIR}/benchmark_results"

cd "${REPO_DIR}"

module use /soft/modulefiles
module load conda
conda activate tuned_lens_env

export PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}"
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false

mkdir -p "${RESULTS_DIR}"

echo "Host: $(hostname)"
echo "Working directory: ${REPO_DIR}"
echo "Results directory: ${RESULTS_DIR}"
echo "Python: $(which python)"
echo "Starting at: $(date)"

nvidia-smi || true

echo
echo "Building indexed_logits CUDA extension..."
python setup.py build_ext --inplace

echo
echo "Quick smoke benchmark (fp16)..."
python benchmark_paper.py \
  --suite quick \
  --dtype fp16 \
  --warmup 10 \
  --iters 25 \
  --output-json "${RESULTS_DIR}/quick_fp16.json" \
  --output-csv "${RESULTS_DIR}/quick_fp16.csv" \
  --output-summary-json "${RESULTS_DIR}/quick_fp16_summary.json" \
  --output-summary-csv "${RESULTS_DIR}/quick_fp16_summary.csv"

echo
echo "Main paper benchmark (fp16)..."
python benchmark_paper.py \
  --suite paper \
  --dtype fp16 \
  --warmup 25 \
  --iters 100 \
  --output-json "${RESULTS_DIR}/paper_fp16.json" \
  --output-csv "${RESULTS_DIR}/paper_fp16.csv" \
  --output-summary-json "${RESULTS_DIR}/paper_fp16_summary.json" \
  --output-summary-csv "${RESULTS_DIR}/paper_fp16_summary.csv"

echo
echo "Main paper benchmark (bf16)..."
python benchmark_paper.py \
  --suite paper \
  --dtype bf16 \
  --warmup 25 \
  --iters 100 \
  --output-json "${RESULTS_DIR}/paper_bf16.json" \
  --output-csv "${RESULTS_DIR}/paper_bf16.csv" \
  --output-summary-json "${RESULTS_DIR}/paper_bf16_summary.json" \
  --output-summary-csv "${RESULTS_DIR}/paper_bf16_summary.csv"

echo
echo "Collision sensitivity benchmark (fp16)..."
python benchmark_paper.py \
  --suite collisions \
  --dtype fp16 \
  --warmup 25 \
  --iters 100 \
  --output-json "${RESULTS_DIR}/collisions_fp16.json" \
  --output-csv "${RESULTS_DIR}/collisions_fp16.csv" \
  --output-summary-json "${RESULTS_DIR}/collisions_fp16_summary.json" \
  --output-summary-csv "${RESULTS_DIR}/collisions_fp16_summary.csv"

echo
echo "Finished at: $(date)"
